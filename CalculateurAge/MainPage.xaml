<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ContentPage.Resources>
        <Color x:Key="FondPageClair">#F4F1FD</Color>
        <Color x:Key="FondPageSombre">#121212</Color>
        <Color x:Key="FondCarteSombre">#1E1E1E</Color>
        <Color x:Key="BordCarteClair">#E7E1FA</Color>
        <Color x:Key="BordCarteSombre">#2C2C2C</Color>
        <Color x:Key="FondChampClair">#F7F5FE</Color>
        <Color x:Key="FondChampSombre">#262626</Color>
        <Color x:Key="BordChampClair">#DDD5F7</Color>
        <Color x:Key="BordChampSombre">#3A3A3A</Color>
        <Color x:Key="Bleu">#1E88E5</Color>
        <Color x:Key="Rouge">#C62828</Color>
        <Color x:Key="RougeClair">#FF8A80</Color>
        <Color x:Key="BordRougeClair">#F3C1C1</Color>
        <Color x:Key="BordRougeSombre">#5C2B2B</Color>
        <Color x:Key="FondMajeurClair">#DCFCE7</Color>
        <Color x:Key="FondMajeurSombre">#14361F</Color>
        <Color x:Key="TexteMajeurClair">#166534</Color>
        <Color x:Key="TexteMajeurSombre">#86EFAC</Color>
        <Color x:Key="FondMineurClair">#FFEDD5</Color>
        <Color x:Key="FondMineurSombre">#4A2A12</Color>
        <Color x:Key="TexteMineurClair">#9A3412</Color>
        <Color x:Key="TexteMineurSombre">#FDBA74</Color>
        <Color x:Key="SeparateurClair">#EEEAFB</Color>

        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource FondCarteSombre}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordCarteClair}, Dark={StaticResource BordCarteSombre}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="TitreCarte" TargetType="Label">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        </Style>

        <Style x:Key="Etiquette" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </Style>

        <Style x:Key="MessageErreur" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Rouge}, Dark={StaticResource RougeClair}}" />
        </Style>

        <Style x:Key="ChampSaisie" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondChampClair}, Dark={StaticResource FondChampSombre}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordChampClair}, Dark={StaticResource BordChampSombre}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="12,2" />
        </Style>

        <Style x:Key="BoutonPrincipal" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="TextColor" Value="{StaticResource White}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="MinimumHeightRequest" Value="56" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="BoutonSecondaire" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Bleu}" />
                                <Setter Property="BorderColor" Value="{StaticResource Bleu}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Bleu}" />
                                <Setter Property="BorderColor" Value="{StaticResource Bleu}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="BoutonDanger" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Rouge}, Dark={StaticResource RougeClair}}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BordRougeClair}, Dark={StaticResource BordRougeSombre}}" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Rouge}" />
                                <Setter Property="BorderColor" Value="{StaticResource Rouge}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Rouge}" />
                                <Setter Property="BorderColor" Value="{StaticResource Rouge}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondMineurClair}, Dark={StaticResource FondMineurSombre}}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding EstMajeur}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondMajeurClair}, Dark={StaticResource FondMajeurSombre}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TexteBadge" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TexteMineurClair}, Dark={StaticResource TexteMineurSombre}}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding EstMajeur}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TexteMajeurClair}, Dark={StaticResource TexteMajeurSombre}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LigneHistorique" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondChampClair}, Dark={StaticResource FondChampSombre}}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource FondPageClair}, Dark={StaticResource FondPageSombre}}">
        <VerticalStackLayout Padding="20,16,20,32" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Calculateur d'âge"
                       FontSize="30" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                <Label Text="Découvrez votre âge en quelques secondes."
                       Style="{StaticResource Etiquette}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Vos informations" Style="{StaticResource TitreCarte}" />

                    <Label Text="Nom" Style="{StaticResource Etiquette}" />
                    <Border Style="{StaticResource ChampSaisie}">
                        <Entry Text="{Binding Nom, Mode=TwoWay}"
                               Placeholder="Votre nom"
                               FontSize="17"
                               ReturnType="Done" />
                    </Border>
                    <!-- Validation : nom vide -->
                    <Label Text="Veuillez saisir votre nom."
                           Style="{StaticResource MessageErreur}"
                           IsVisible="{Binding NomManquant}" />

                    <Label Text="Date de naissance" Style="{StaticResource Etiquette}" />
                    <Border Style="{StaticResource ChampSaisie}">
                        <DatePicker Date="{Binding DateNaissance}"
                                    Format="dd/MM/yyyy"
                                    FontSize="17" />
                    </Border>
                    <!-- Validation : date de naissance dans le futur -->
                    <Label Text="La date de naissance ne peut pas être dans le futur."
                           Style="{StaticResource MessageErreur}"
                           IsVisible="{Binding DateFuture}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Button Text="Calculer"
                        Style="{StaticResource BoutonPrincipal}"
                        Command="{Binding CalculerCommand}" />
                <!-- Fonctionnalite 2 : bouton Reinitialiser -->
                <Button Text="Réinitialiser"
                        Style="{StaticResource BoutonSecondaire}"
                        Command="{Binding ReinitialiserCommand}" />
            </VerticalStackLayout>

            <!-- Fonctionnalites 3 et 4 : carte resultat avec statut et prochain anniversaire -->
            <Border Style="{StaticResource Carte}"
                    IsVisible="{Binding ResultatVisible}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Votre résultat" Style="{StaticResource TitreCarte}" />
                    <Label Text="{Binding Resultat}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                    <Border Style="{StaticResource Badge}">
                        <Label Text="{Binding StatutPhrase}" Style="{StaticResource TexteBadge}" />
                    </Border>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SeparateurClair}, Dark={StaticResource BordCarteSombre}}" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding AnniversaireTitre}"
                               FontSize="17" FontAttributes="Bold" />
                        <Label Text="{Binding AnniversaireDetail}"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Fonctionnalite 1 : consulter la derniere sauvegarde -->
            <Border Style="{StaticResource Carte}"
                    IsVisible="{Binding ADernierResultat}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Dernière sauvegarde" Style="{StaticResource TitreCarte}" />
                    <Label Text="{Binding DernierResultat.Resultat}"
                           FontSize="17" FontAttributes="Bold" />
                    <Label Text="{Binding DernierResultat.StatutPhrase}" FontSize="15" />
                    <Label Text="{Binding DernierResultat.Anniversaire}" FontSize="15" />
                    <Label Text="{Binding DernierResultat.DateCalculTexte}"
                           Style="{StaticResource Etiquette}" FontSize="13" />
                    <Button Text="Consulter ce résultat"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding RestaurerDernierResultatCommand}"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Fonctionnalite 5 : historique des calculs -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Historique"
                               Style="{StaticResource TitreCarte}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Historique.Count, StringFormat='{0} calcul(s)'}"
                               Style="{StaticResource Etiquette}"
                               FontSize="13"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Aucun calcul dans l'historique pour le moment."
                           Style="{StaticResource Etiquette}"
                           HorizontalTextAlignment="Center"
                           Padding="0,16"
                           IsVisible="{Binding HistoriqueVide}" />

                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Historique}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LigneHistorique}">
                                    <Label Text="{Binding LigneHistorique}"
                                           FontSize="16"
                                           LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Effacer l'historique"
                            Style="{StaticResource BoutonDanger}"
                            Command="{Binding EffacerHistoriqueCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
